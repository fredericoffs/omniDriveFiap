            },
            "description": "Placa e chassi são únicos: a API recusa o cadastro duplicado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chassis\": \"{{chassisA}}\",\n  \"plate\": \"{{plateA}}\",\n  \"mileage\": 45000,\n  \"brand\": \"Fiat\",\n  \"model\": \"Uno\",\n  \"year\": 2020,\n  \"color\": \"Prata\",\n  \"purchasePrice\": 30000,\n  \"salePrice\": 40000,\n  \"origin\": \"OWNED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
