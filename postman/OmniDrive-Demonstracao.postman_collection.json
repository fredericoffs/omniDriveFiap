{
  "info": {
    "name": "OmniDrive - Demonstração",
    "description": "Fluxo completo da API para o vídeo. Rode as pastas na ordem (ou use o Collection Runner). Os ids, a version e os códigos de pagamento são guardados sozinhos nas variáveis da coleção. Escolha o ambiente OmniDrive - Docker Compose (porta 8080) ou OmniDrive - Kubernetes (porta 30080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparação",
      "description": "Confere se a aplicação está no ar. Execute antes de gravar.",
      "item": [
        {
          "name": "0.1 Saúde da aplicação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Mostra o endpoint usado como probe de liveness e readiness no Kubernetes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Status UP\", () => pm.expect(j.status === \"UP\").to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 (Opcional) Gerar novos dados do veículo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Use ao regravar sem zerar o banco: sorteia placas e chassis novos, porque placa e chassi são únicos. Na primeira gravação NÃO precisa executar (os dados padrão são ABC1D23 e DEF2G34)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const L = 'ABCDEFGHJKLMNPRSTUVWXYZ';",
                  "const r = s => s[Math.floor(Math.random() * s.length)];",
                  "const n = k => Array.from({length: k}, () => Math.floor(Math.random() * 10)).join('');",
                  "const plate = () => r(L) + r(L) + r(L) + n(1) + r(L) + n(2);",
                  "pm.collectionVariables.set(\"plateA\", plate());",
                  "pm.collectionVariables.set(\"plateB\", plate());",
                  "pm.collectionVariables.set(\"chassisA\", \"9BWZZZ377LT\" + n(6));",
                  "pm.collectionVariables.set(\"chassisB\", \"9BWZZZ377JT\" + n(6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Novos dados:\", pm.collectionVariables.get(\"plateA\"), pm.collectionVariables.get(\"plateB\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Cadastro e edição",
      "description": "Cadastrar dois veículos, tentar duplicar e editar com controle de versão.",
      "item": [
        {
          "name": "1.1 Cadastrar veículo A (Fiat Uno, R$ 40.000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles"
              ]
            },
            "description": "Nasce com status RECEIVED. O id e a version são guardados nas variáveis.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chassis\": \"{{chassisA}}\",\n  \"plate\": \"{{plateA}}\",\n  \"mileage\": 45000,\n  \"brand\": \"Fiat\",\n  \"model\": \"Uno\",\n  \"year\": 2020,\n  \"color\": \"Prata\",\n  \"purchasePrice\": 30000,\n  \"salePrice\": 40000,\n  \"origin\": \"OWNED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Status RECEIVED\", () => pm.expect(j.status === \"RECEIVED\").to.be.true);",
                  "pm.collectionVariables.set(\"vehicleAId\", String(j.id));",
                  "pm.collectionVariables.set(\"vehicleAVersion\", String(j.version));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Cadastrar veículo B (VW Gol, R$ 25.000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
