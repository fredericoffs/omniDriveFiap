        {
          "name": "1.5 Editar veículo A (cor e preço)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles/{{vehicleAId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "{{vehicleAId}}"
              ]
            },
            "description": "Envia a version lida. A cor vira Preto e o preço de venda vai para 41.000.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{plateA}}\",\n  \"mileage\": 45000,\n  \"brand\": \"Fiat\",\n  \"model\": \"Uno\",\n  \"year\": 2020,\n  \"color\": \"Preto\",\n  \"purchasePrice\": 30000,\n  \"salePrice\": 41000,\n  \"origin\": \"OWNED\",\n  \"version\": {{vehicleAVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"vehicleAStaleVersion\", pm.collectionVariables.get(\"vehicleAVersion\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Cor Preto\", () => pm.expect(j.color === \"Preto\").to.be.true);",
                  "pm.test(\"Preço de venda 41000\", () => pm.expect(j.salePrice === 41000).to.be.true);",
                  "pm.collectionVariables.set(\"vehicleAVersion\", String(j.version));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Editar veículo A com a versão antiga (esperado: 409)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles/{{vehicleAId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "{{vehicleAId}}"
              ]
            },
            "description": "Simula outra pessoa que alterou o veículo no meio-tempo: a edição é recusada em vez de sobrescrever.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{plateA}}\",\n  \"mileage\": 45000,\n  \"brand\": \"Fiat\",\n  \"model\": \"Uno\",\n  \"year\": 2020,\n  \"color\": \"Preto\",\n  \"purchasePrice\": 30000,\n  \"salePrice\": 41000,\n  \"origin\": \"OWNED\",\n  \"version\": {{vehicleAStaleVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 409\", () => pm.response.to.have.status(409));",
                  "const j = pm.response.json();",
                  "pm.test(\"Mensagem de conflito\", () => pm.expect(j.detail.includes(\"alterado por outra operação\")).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
