    {
      "name": "3. Venda",
      "description": "Venda cria o pagamento Aguardando e reserva o veículo.",
      "item": [
        {
          "name": "3.1 Efetuar venda do veículo A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales"
              ]
            },
            "description": "CPF do comprador e data de hoje (a API recusa data futura). Guarda o paymentCode.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleAId}}\",\n  \"buyerCpf\": \"{{buyerCpf}}\",\n  \"saleDate\": \"{{saleDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "const p = n => String(n).padStart(2, '0');",
                  "pm.collectionVariables.set(\"saleDate\", d.getFullYear() + \"-\" + p(d.getMonth() + 1) + \"-\" + p(d.getDate()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Pagamento AWAITING_PAYMENT\", () => pm.expect(j.paymentStatus === \"AWAITING_PAYMENT\").to.be.true);",
                  "pm.test(\"Valor copiado do preço do veículo (41000)\", () => pm.expect(j.amount === 41000).to.be.true);",
                  "pm.collectionVariables.set(\"saleAId\", String(j.id));",
                  "pm.collectionVariables.set(\"paymentCodeA\", String(j.paymentCode));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Consultar veículo A (RESERVED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles/{{vehicleAId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "{{vehicleAId}}"
              ]
            },
            "description": "O veículo ficou reservado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Veículo está RESERVED\", () => pm.expect(j.status === \"RESERVED\").to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Listar à venda (só o B)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles/for-sale",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "for-sale"
              ]
            },
            "description": "O A saiu da vitrine."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Só um veículo\", () => pm.expect(j.totalElements === 1).to.be.true);",
                  "pm.test(\"É o Gol\", () => pm.expect(j.content[0].salePrice === 25000).to.be.true);"
                ]
              }
            }
          ]
        },
