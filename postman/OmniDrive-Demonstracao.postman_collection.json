                "{{baseUrl}}"
              ],
              "path": [
                "vehicles"
              ]
            },
            "description": "Mais barato que o A, para mostrar a ordenação por preço.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chassis\": \"{{chassisB}}\",\n  \"plate\": \"{{plateB}}\",\n  \"mileage\": 80000,\n  \"brand\": \"Volkswagen\",\n  \"model\": \"Gol\",\n  \"year\": 2018,\n  \"color\": \"Branco\",\n  \"purchasePrice\": 18000,\n  \"salePrice\": 25000,\n  \"origin\": \"OWNED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
